    "var('f l c');radians = pi/180.0;degrees = 180.0/pi\n",
    "def argd(x):\n",
    "    return N(arg(x) * degrees)\n",
    "def plt(q,a,b,typ = abs,col = 'blue'):\n",
    "     return plot(lambda x: float(typ(q(x))),(x,a,b),rgbcolor=col)\n",
    "omega = 2*pi*f    \n",
    "zs(r,l,c,f) = r + (i*omega*l) - i/(omega*c)"
   ]
